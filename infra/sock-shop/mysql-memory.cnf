[mysqld]
performance_schema=OFF
innodb_buffer_pool_size=64M
innodb_buffer_pool_chunk_size=64M
innodb_buffer_pool_instances=1
key_buffer_size=8M
max_connections=30
thread_cache_size=4
table_open_cache=128
table_definition_cache=400
tmp_table_size=8M
max_heap_table_size=8M
query_cache_type=0
query_cache_size=0
