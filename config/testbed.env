# Development budget adjusted after measured 6GiB cgroup memory pressure.
PROFILE=shyn-thesis
CPUS=4
MEMORY_MB=7168
# Chaos Mesh 2.8 supports Kubernetes 1.35-1.37; kubectl is 1.37.1.
# Pinned version verified on this host; benchmark protocol remains draft.
KUBERNETES_VERSION=v1.37.0
SOCK_SHOP_NAMESPACE=sock-shop
